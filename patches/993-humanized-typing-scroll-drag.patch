+namespace {
+
+// The root widget of a target's page, or an error for the callback.
+base::WeakPtr<RenderWidgetHostImpl> HumanizedRoot(const std::string& target_id,
+                                                  std::string* error) {
+  scoped_refptr<DevToolsAgentHost> host = DevToolsAgentHost::GetForId(target_id);
+  WebContents* web_contents = host ? host->GetWebContents() : nullptr;
+  RenderWidgetHost* rwh =
+      web_contents && web_contents->GetRenderWidgetHostView()
+          ? web_contents->GetRenderWidgetHostView()->GetRenderWidgetHost()
+          : nullptr;
+  if (!rwh) {
+    *error = !host ? "No target with given targetId"
+                   : !web_contents ? "Target has no WebContents"
+                                   : "No active RenderWidgetHost";
+    return nullptr;
+  }
+  return static_cast<RenderWidgetHostImpl*>(rwh)->GetWeakPtr();
+}
+
+template <typename Callback>
+HumanizedDone AnswerWhenDone(std::unique_ptr<Callback> callback) {
+  return base::BindOnce(
+      [](std::unique_ptr<Callback> cb, const std::string& error) {
+        if (error.empty()) {
+          cb->sendSuccess();
+        } else {
+          cb->sendFailure(Response::ServerError(error));
+        }
+      },
+      std::move(callback));
+}
+
+}  // namespace
+
+void BrowserHandler::HumanizedType(
+    const std::string& in_target_id,
+    const std::string& in_text,
+    std::optional<double> in_cpm,
+    std::optional<double> in_typo_rate,
+    std::unique_ptr<HumanizedTypeCallback> callback) {
+  std::string error;
+  base::WeakPtr<RenderWidgetHostImpl> root = HumanizedRoot(in_target_id, &error);
+  if (!root) {
+    callback->sendFailure(Response::InvalidParams(error));
+    return;
+  }
+  HumanizedTypeOptions options;
+  options.cpm = in_cpm.value_or(options.cpm);
+  options.typo_rate = in_typo_rate.value_or(options.typo_rate);
+  StartHumanizedType(std::move(root), in_text, options,
+                     AnswerWhenDone(std::move(callback)));
+}
+
+void BrowserHandler::HumanizedScroll(
+    const std::string& in_target_id,
+    std::optional<double> in_x,
+    std::optional<double> in_y,
+    std::optional<double> in_delta_x,
+    double in_delta_y,
+    std::optional<std::string> in_style,
+    std::unique_ptr<HumanizedScrollCallback> callback) {
+  std::string error;
+  base::WeakPtr<RenderWidgetHostImpl> root = HumanizedRoot(in_target_id, &error);
+  if (!root) {
+    callback->sendFailure(Response::InvalidParams(error));
+    return;
+  }
+  const std::string style_name = in_style.value_or("auto");
+  HumanizedScrollStyle style;
+  if (style_name == "auto") {
+    style = HumanizedScrollStyle::kAuto;
+  } else if (style_name == "wheel") {
+    style = HumanizedScrollStyle::kWheel;
+  } else if (style_name == "trackpad") {
+    style = HumanizedScrollStyle::kTrackpad;
+  } else if (style_name == "swipe") {
+    style = HumanizedScrollStyle::kSwipe;
+  } else {
+    callback->sendFailure(Response::InvalidParams(
+        "style must be auto, wheel, trackpad or swipe"));
+    return;
+  }
+  gfx::PointF& cursor = LastHumanizedCursorPos(in_target_id);
+  const gfx::PointF start = cursor;
+  gfx::PointF at = start;
+  if (in_x.has_value() && in_y.has_value()) {
+    at = gfx::PointF(static_cast<float>(*in_x), static_cast<float>(*in_y));
+  } else if (start.IsOrigin() && root->GetView()) {
+    // No pointer position yet: scroll over the middle of the viewport.
+    const gfx::Size size = root->GetView()->GetVisibleViewportSize();
+    at = gfx::PointF(size.width() / 2.0f, size.height() / 2.0f);
+  }
+  cursor = at;
+  StartHumanizedScroll(std::move(root), start, at, in_delta_x.value_or(0),
+                       in_delta_y, style, AnswerWhenDone(std::move(callback)));
+}
+
+void BrowserHandler::HumanizedDrag(
+    const std::string& in_target_id,
+    double in_from_x,
+    double in_from_y,
+    double in_to_x,
+    double in_to_y,
+    std::optional<double> in_duration,
+    std::unique_ptr<HumanizedDragCallback> callback) {
+  std::string error;
+  base::WeakPtr<RenderWidgetHostImpl> root = HumanizedRoot(in_target_id, &error);
+  if (!root) {
+    callback->sendFailure(Response::InvalidParams(error));
+    return;
+  }
+  gfx::PointF& cursor = LastHumanizedCursorPos(in_target_id);
+  const gfx::PointF start = cursor;
+  const gfx::PointF to(static_cast<float>(in_to_x), static_cast<float>(in_to_y));
+  cursor = to;
+  StartHumanizedDrag(
+      std::move(root), start,
+      gfx::PointF(static_cast<float>(in_from_x), static_cast<float>(in_from_y)),
+      to, std::clamp(in_duration.value_or(0.5), 0.05, 10.0),
+      AnswerWhenDone(std::move(callback)));
+}
