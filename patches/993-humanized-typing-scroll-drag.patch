+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_HUMANIZED_INPUT_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_HUMANIZED_INPUT_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content {
+
+class RenderWidgetHostImpl;
+
+namespace protocol {
+
+// camchrome (993): the human input engine behind Browser.humanizedType,
+// Browser.humanizedScroll and Browser.humanizedDrag. Like humanizedClick (130),
+// every event is built here as real WebInputEvents and routed through the
+// browser's input path (no debugger marker), so pages see isTrusted input with
+// human timing. Each Start* call owns itself until `done` runs; `done` gets an
+// empty string on success or an error message.
+using HumanizedDone = base::OnceCallback<void(const std::string& error)>;
+
+struct HumanizedTypeOptions {
+  // Characters per minute; 300 is about 60 words per minute.
+  double cpm = 300;
+  // Chance per letter of hitting a neighbouring key first, then correcting it
+  // with Backspace. 0 disables typos.
+  double typo_rate = 0;
+};
+
+// Types `text` (UTF-8) into whatever has focus in the page: per-key down/up
+// with dwell and rollover, Shift held for capitals and symbols, longer gaps
+// after spaces and punctuation, occasional pauses, optional corrected typos.
+// Characters outside the US layout are committed as IME text.
+void StartHumanizedType(base::WeakPtr<RenderWidgetHostImpl> root,
+                        const std::string& text,
+                        const HumanizedTypeOptions& options,
+                        HumanizedDone done);
+
+// How a scroll is produced. kAuto picks from the persona platform: trackpad
+// for macOS, a finger swipe for Android, wheel notches otherwise.
+enum class HumanizedScrollStyle { kAuto, kWheel, kTrackpad, kSwipe };
+
+// Moves the pointer from `cursor` to `at` (if they differ), then scrolls by
+// (delta_x, delta_y) CSS px (positive delta_y scrolls the page down).
+// Wheel: notches of 100 px (Windows personas) or 120 px (Linux) in flicks with
+// began/changed/ended phases. Trackpad: precise deltas with a gesture and a
+// decaying momentum phase. Swipe: finger drags (touch on an Android persona,
+// see 992), each at most half the viewport.
+void StartHumanizedScroll(base::WeakPtr<RenderWidgetHostImpl> root,
+                          gfx::PointF cursor,
+                          gfx::PointF at,
+                          double delta_x,
+                          double delta_y,
+                          HumanizedScrollStyle style,
+                          HumanizedDone done);
+
+// Moves the pointer from `cursor` to `from`, presses, follows a human path to
+// `to` over `duration_seconds`, holds briefly and releases. On an Android
+// persona the emulator turns this into a touch swipe.
+void StartHumanizedDrag(base::WeakPtr<RenderWidgetHostImpl> root,
+                        gfx::PointF cursor,
+                        gfx::PointF from,
+                        gfx::PointF to,
+                        double duration_seconds,
+                        HumanizedDone done);
+
+}  // namespace protocol
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_HUMANIZED_INPUT_H_
