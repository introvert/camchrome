camchrome: an Android persona has overlay scrollbars.

Android Chrome draws overlay scrollbars that take no layout width. On a Linux or Windows host the
renderer kept the host's classic 15 px scrollbar, so an Android persona reported
innerWidth - clientWidth = 15 on any scrolling page, and every overflow:scroll box lost 15 px: a
desktop scrollbar under a phone UA. The renderer now enables overlay scrollbars (and turns Fluent
scrollbars off) when the persona is Android, as DevTools' mobile emulation does.

Checked by fingerprint_selftest's scrollbar-width-matches-persona-os with --platform android.
A macOS host keeps its own scroller style; a desktop persona on a Mac with overlay scrollbars
(0 px instead of Windows/Linux's 15 px) still needs a Mac-side change.

--- a/content/child/runtime_features.cc
+++ b/content/child/runtime_features.cc
@@ -43,6 +43,7 @@
 #include "third_party/blink/public/common/loader/referrer_utils.h"
 #include "third_party/blink/public/common/switches.h"
 #include "third_party/blink/public/platform/web_runtime_features.h"
+#include "components/ungoogled/persona_profile.h"
 #include "components/ungoogled/ungoogled_switches.h"
 #include "ui/accessibility/accessibility_features.h"
 #include "ui/base/ui_base_features.h"
@@ -448,6 +449,14 @@
   WebRuntimeFeatures::EnableOverlayScrollbars(
       ui::NativeTheme::GetInstanceForWeb()->use_overlay_scrollbar());
   WebRuntimeFeatures::EnableFluentScrollbars(ui::IsFluentScrollbarEnabled());
+  // camchrome (999): an Android persona has Android's overlay scrollbars, which take no layout
+  // width. The host's classic 15 px scrollbar made innerWidth - clientWidth (and any
+  // overflow:scroll box) report a desktop scrollbar under a phone UA.
+  if (ungoogled::PersonaActive() &&
+      ungoogled::GetPersonaPlatform() == ungoogled::PersonaPlatform::kAndroid) {
+    WebRuntimeFeatures::EnableOverlayScrollbars(true);
+    WebRuntimeFeatures::EnableFluentScrollbars(false);
+  }
 #if BUILDFLAG(IS_ANDROID)
   WebRuntimeFeatures::EnableAudioOutputDevices(
       base::FeatureList::IsEnabled(features::kAAudioPerStreamDeviceSelection) &&
