 namespace {
 
+// camchrome (999): the scrollbar style follows the persona OS, not the host theme. Android
+// draws overlay scrollbars that take no layout width; Windows and Linux draw classic ones that
+// do. A macOS persona keeps the host style (a Mac shows either, depending on the pointing
+// device). Without this an Android persona on a Linux host reported a 15 px desktop scrollbar,
+// and a Windows persona on a Mac with overlay scrollbars reported none.
+bool PersonaUseOverlayScrollbar(bool host_value) {
+  if (!ungoogled::PersonaActive())
+    return host_value;
+  switch (ungoogled::GetPersonaPlatform()) {
+    case ungoogled::PersonaPlatform::kAndroid:
+      return true;
+    case ungoogled::PersonaPlatform::kWindows:
+    case ungoogled::PersonaPlatform::kLinux:
+      return false;
+    default:
+      return host_value;
+  }
+}
