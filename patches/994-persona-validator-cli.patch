# 994-persona-validator-cli.patch
#
# camchrome: the persona validator as a small standalone binary, and the persona bugs it found.
#
# persona_validator_cli (components/ungoogled, testonly) runs exactly what
# `chrome --clearcote-validate-persona=...` runs, but links only //base and the ungoogled
# component (~300 ninja steps instead of a browser), so CI and
# tools/fingerprint_library.py can check seed-derived personas and imported captures on every
# push:
#
#   persona_validator_cli --clearcote-validate-persona=512 --fingerprint-platform=macos
#   persona_validator_cli --clearcote-validate-persona=current \
#       --fingerprint-platform=android --fingerprint-profile=H4sI...
#
# Running it across platforms showed the validator and the derivation had drifted apart:
#
#   * The validator still treated macOS as "not modelled" and checked it against the Windows
#     rules, so every macOS seed failed (Metal renderer "not Direct3D", "metal-3" not a known
#     WebGPU architecture). 987 gave macOS its own block; the validator now has macOS rules:
#     Metal backend, an Apple Silicon RAM configuration, a speech engine, no touchscreen.
#   * Schema 2's desktop draw can give a Windows touch laptop's 10 touch points, and the macOS
#     block kept them: maxTouchPoints 10 under a Mac UA. The macOS block now sets 0.
#   * The android and macOS blocks run after the --fingerprint-profile import and overwrite
#     the device wholesale. An imported Android capture lost its own GPU and screen to a random
#     device row (WebGL said Mali while the captured WebGPU said qualcomm); a partial macOS
#     capture skipped the macOS block and kept Windows SAPI voices and Realtek devices. Both
#     platform blocks now run, then the capture is re-applied, so it wins for every field it
#     carries and the platform table fills only the rest.
#   * Without --fingerprint-platform DerivePersona() takes the host platform, but the validator
#     assumed Windows, so `chrome --clearcote-validate-persona=64` on a Linux build failed
#     every seed. It now mirrors the host mapping.
#   * The macOS tier/screen pairing is not modelled (Mac screens are logical points sized by
#     the model), so that one schema-2 rule is skipped for macOS.
#
# Tests: CI builds the binary on linux-x64 and runs
# tools/fingerprint_library.py selftest --validator ..., which sweeps 256 seeds on every
# platform for both schemas, imports a capture-shaped profile for each OS, and checks that
# broken imports (Direct3D or touch on macOS, no touch on Android, GL under Windows, WebGPU
# vendor mismatch) are refused.
--- a/components/ungoogled/BUILD.gn
+++ b/components/ungoogled/BUILD.gn
@@ -31,3 +31,16 @@
     "//components/os_crypt/async/browser:key_provider_interface",
   ]
 }
+
+# camchrome: the persona validator as a small executable, so CI and
+# tools/fingerprint_library.py can check personas and library profiles without
+# a full browser build.
+executable("persona_validator_cli") {
+  testonly = true
+  sources = [ "persona_validator_main.cc" ]
+  deps = [
+    ":ungoogled_switches",
+    "//base",
+    "//components/version_info",
+  ]
+}
--- a/components/ungoogled/persona_profile.cc
+++ b/components/ungoogled/persona_profile.cc
@@ -1196,9 +1196,9 @@
   // camchrome: macOS persona. The derivation above is Windows-shaped (ANGLE
   // Direct3D, SAPI voices, WASAPI devices, Windows screen pool); under a macOS
   // claim each of those is provable incoherence. Rewrite them to what Chrome on
-  // Apple Silicon reports. An imported capture is authoritative and untouched.
-  if (platform == PersonaPlatform::kMacOS &&
-      !DecodedProfileSwitch()) {
+  // Apple Silicon reports. An imported capture is re-applied on top below, so
+  // it stays authoritative for every field it has and this fills the rest.
+  if (platform == PersonaPlatform::kMacOS) {
     const MacScreen& ms = kMacScreens[rng() % std::size(kMacScreens)];
     p.screen_width = ms.w;
     p.screen_height = ms.h;
@@ -1206,6 +1206,10 @@
     p.avail_screen_height = ms.avail_h;
     p.device_pixel_ratio = 2.0;
     p.color_depth = 24;
+    // No Mac has a touchscreen: Chrome on macOS reports maxTouchPoints 0 and
+    // any-pointer:fine. The schema-2 desktop draw above can pick a Windows
+    // touch laptop's 10 points, which a Mac UA turns into a contradiction.
+    p.max_touch_points = 0;
 
     // The host's real core count is measured by the audit's worker test, so a
     // claim below it is provably false. Pick an Apple tier at or above it.
@@ -1305,6 +1309,15 @@
         {"audiooutput", "MacBook Pro Speakers", mac_spk, mac_grp},
     };
   }
+  // camchrome (994): the android and macOS blocks rewrite the whole device
+  // (screen, cores, RAM, GPU, limits, devices) from their own tables, after
+  // ApplyProfileOverride() ran. Without this an imported Android capture lost
+  // its own GPU and screen to a random device row (WebGL said Mali while the
+  // captured WebGPU said qualcomm), and a partial macOS capture kept the
+  // Windows SAPI voices and Realtek devices. Re-applying the capture makes it
+  // win for every field it carries; the platform table fills only the rest.
+  if (platform == PersonaPlatform::kAndroid || platform == PersonaPlatform::kMacOS)
+    ApplyProfileOverride(&p);
   if (cmd->HasSwitch(switches::kFingerprintGpuVendor))
     p.webgl_vendor = cmd->GetSwitchValueASCII(switches::kFingerprintGpuVendor);
   if (cmd->HasSwitch(switches::kFingerprintGpuRenderer))
--- a/components/ungoogled/persona_validator.cc
+++ b/components/ungoogled/persona_validator.cc
@@ -132,11 +132,21 @@
 std::string S(double v) { return base::NumberToString(v); }
 
 PersonaPlatform EffectivePlatform(PersonaPlatform p) {
-  // DerivePersona() only rewrites the Windows-shaped defaults for kLinux and
-  // kAndroid. kUnset and kMacOS keep them, so they validate as Windows-shaped.
-  if (p == PersonaPlatform::kLinux || p == PersonaPlatform::kAndroid)
+  // DerivePersona() rewrites the Windows-shaped defaults for kLinux, kAndroid
+  // and (987) kMacOS, and a launch without --fingerprint-platform takes the
+  // HOST platform there. Mirror that, or `chrome --clearcote-validate-persona`
+  // on a Linux build checks a Linux persona against the Windows rules.
+  if (p != PersonaPlatform::kUnset)
     return p;
+#if BUILDFLAG(IS_MAC)
+  return PersonaPlatform::kMacOS;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  return PersonaPlatform::kLinux;
+#elif BUILDFLAG(IS_ANDROID)
+  return PersonaPlatform::kAndroid;
+#else
   return PersonaPlatform::kWindows;
+#endif
 }
 
