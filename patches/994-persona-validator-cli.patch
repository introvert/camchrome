+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// camchrome: the persona validator without the browser. Runs the same code as
+// `chrome --clearcote-validate-persona=...` (persona_validator.h), so persona
+// derivation, --fingerprint-profile import and every coherence invariant can be
+// checked from a cheap build of one component:
+//
+//   persona_validator_cli --clearcote-validate-persona=64 --fingerprint-platform=android
+//   persona_validator_cli --clearcote-validate-persona=current \
+//       --fingerprint-platform=windows --fingerprint-profile=H4sI...
+//
+// Exit codes are the validator's: 0 clean, 3 contradictions, 2 bad arguments.
+
+#include <cstdio>
+#include <optional>
+#include <string>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "components/ungoogled/persona_validator.h"
+#include "components/version_info/version_info.h"
+
+int main(int argc, char** argv) {
+  base::AtExitManager exit_manager;
+  base::CommandLine::Init(argc, argv);
+  const std::optional<int> rc = ungoogled::MaybeRunPersonaValidationCli(
+      *base::CommandLine::ForCurrentProcess(),
+      std::string(version_info::GetVersionNumber()));
+  if (!rc) {
+    fprintf(stderr,
+            "usage: persona_validator_cli --clearcote-validate-persona=<N|a,b,c|current> "
+            "[--fingerprint-platform=...] [--fingerprint-profile=...]\n");
+    return 2;
+  }
+  return *rc;
+}
