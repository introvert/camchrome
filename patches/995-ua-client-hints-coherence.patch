+// camchrome: how UA client hints are made to agree with the persona and with the User-Agent
+// string actually in effect. Kept out of user_agent_metadata.h, which most of the tree includes.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_USER_AGENT_USER_AGENT_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_USER_AGENT_USER_AGENT_FINGERPRINT_H_
+
+#include <string>
+
+#include "third_party/blink/public/common/common_export.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+
+namespace blink {
+
+// The entry point for every consumer of UA client hints. `metadata` is what the consumer
+// received; `is_explicit_override` whether it came from a DevTools/automation or embedder
+// override; `effective_user_agent` the User-Agent actually in effect. An override is left as
+// given; otherwise the fingerprint is applied and the result made to agree with the UA string
+// (major version, brand tokens, OS), so a --user-agent switch stays coherent.
+BLINK_COMMON_EXPORT void UpdateUserAgentMetadataFingerprint(
+    UserAgentMetadata* metadata,
+    bool is_explicit_override,
+    const std::string& effective_user_agent);
+
+// Metadata for a UA-only override (CDP Emulation.setUserAgentOverride without
+// userAgentMetadata): the fingerprinted default, made to agree with `user_agent`.
+BLINK_COMMON_EXPORT UserAgentMetadata UserAgentMetadataForUserAgentOverride(
+    UserAgentMetadata platform_default,
+    const std::string& user_agent);
+
+// Rewrites the brand versions and OS of `metadata` to those `user_agent` claims. A no-op when
+// they already agree or when `user_agent` is not a Chromium UA.
+BLINK_COMMON_EXPORT void ReconcileUserAgentMetadataWithUserAgent(
+    const std::string& user_agent,
+    UserAgentMetadata* metadata);
+
+}  // namespace blink
