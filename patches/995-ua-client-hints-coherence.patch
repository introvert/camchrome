+// camchrome: whether the UA client hints in `context` come from an override (DevTools/automation
+// via the emulation probe, or the embedder's frame override) rather than the browser's own.
+bool IsUserAgentMetadataOverridden(ExecutionContext* context) {
+  if (!context)
+    return false;
+  // A dedicated worker's metadata was finalised by its creator (dedicated_worker.cc).
+  if (context->IsDedicatedWorkerGlobalScope())
+    return true;
+  std::optional<UserAgentMetadata> devtools_metadata;
+  probe::ApplyUserAgentMetadataOverride(probe::ToCoreProbeSink(context),
+                                        &devtools_metadata);
+  if (devtools_metadata.has_value())
+    return true;
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      return !frame->Client()->UserAgentOverride().empty();
+    }
+  }
+  return false;
+}
