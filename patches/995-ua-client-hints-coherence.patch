+// camchrome: the Edge build that ships on this engine's Chromium major (fingerprint_data.h
+// kEdgeStable), or "<major>.0.0.0" when the table has no row for it.
+std::string EdgeFullVersionForEngine() {
+  const std::string major = GetMajorVersion(ungoogled::EngineVersionNumber());
+  int major_int = 0;
+  base::StringToInt(major, &major_int);
+  for (const auto& row : ungoogled::fingerprint::kEdgeStable) {
+    if (row.chromium_major == major_int)
+      return row.edge_full_version;
+  }
+  return major + ".0.0.0";
+}
+
+// camchrome: Opera and Vivaldi have no default version (fingerprint_data.h). Returns the
+// version to claim for `brand`, or "" when the brand must not be claimed.
+std::string ExplicitBrandVersion(const std::string& brand,
+                                 const std::string& custom_version) {
+  if (custom_version.empty()) {
+    static std::atomic<bool> warned{false};
+    if (!warned.exchange(true)) {
+      LOG(WARNING) << "--fingerprint-brand=" << brand
+                   << " needs --fingerprint-brand-version=<" << brand
+                   << " version>; claiming plain Chromium instead";
+    }
+  }
+  return custom_version;
+}
