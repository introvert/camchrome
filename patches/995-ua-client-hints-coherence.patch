+// camchrome: make `metadata` describe the browser named by `user_agent`. A UA string from
+// --user-agent or an automation tool's override used to leave the client hints on the engine's
+// own version and OS (UA "Chrome/150 ... Windows" next to Sec-CH-UA 157 on macOS), which is the
+// textbook UA-spoofing tell. Only what the UA string determines is changed: the Chromium/Chrome
+// major, the Edge/Opera/Vivaldi tokens, and the OS. Nothing changes when they already agree.
+void ReconcileUserAgentMetadataWithUserAgent(const std::string& user_agent,
+                                             UserAgentMetadata* metadata) {
+  if (!metadata || user_agent.empty())
+    return;
+  auto token_version = [&](std::string_view token) -> std::string {
+    size_t pos = user_agent.find(token);
+    if (pos == std::string::npos)
+      return std::string();
+    pos += token.size();
+    size_t end = pos;
+    while (end < user_agent.size() &&
+           (base::IsAsciiDigit(user_agent[end]) || user_agent[end] == '.'))
+      ++end;
+    return user_agent.substr(pos, end - pos);
+  };
+  const std::string chrome_token = token_version("Chrome/");
+  if (chrome_token.empty())
+    return;  // Not a Chromium UA: leave the hints alone.
+  const std::string major = GetMajorVersion(chrome_token);
+  const std::string edge_token = token_version(" Edg/");
+  const std::string opera_token = token_version(" OPR/");
+  const std::string vivaldi_token = token_version(" Vivaldi/");
+
+  // The full Chrome version to pair with `major`: an explicit full --fingerprint-brand-version,
+  // else the engine's when the majors agree, else the reduced form.
+  std::string chrome_full;
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  const std::string custom =
+      command_line->HasSwitch(switches::kFingerprintBrandVersion)
+          ? command_line->GetSwitchValueASCII(switches::kFingerprintBrandVersion)
+          : std::string();
+  const std::string engine = ungoogled::EngineVersionNumber();
+  if (!custom.empty() && GetMajorVersion(custom) == major &&
+      std::count(custom.begin(), custom.end(), '.') >= 3) {
+    chrome_full = custom;
+  } else if (GetMajorVersion(engine) == major) {
+    chrome_full = engine;
+  } else {
+    chrome_full = major + ".0.0.0";
+  }
+
+  auto rebuild = [&](UserAgentBrandList& list, bool full) {
+    UserAgentBrandList out;
+    for (UserAgentBrandVersion bv : list) {
+      if (bv.brand == "Chromium" || bv.brand == "Google Chrome") {
+        bv.version = full ? chrome_full : major;
+      } else if (bv.brand == ungoogled::fingerprint::kEdgeDisplayName) {
+        if (edge_token.empty())
+          continue;  // The UA does not claim Edge.
+        const std::string edge_full =
+            GetMajorVersion(edge_token) == GetMajorVersion(EdgeFullVersionForEngine())
+                ? EdgeFullVersionForEngine()
+                : GetMajorVersion(edge_token) + ".0.0.0";
+        bv.version = full ? edge_full : GetMajorVersion(edge_token);
+      } else if (bv.brand == ungoogled::fingerprint::kOperaDisplayName) {
+        if (opera_token.empty())
+          continue;
+        bv.version = full ? opera_token : GetMajorVersion(opera_token);
+      } else if (bv.brand == ungoogled::fingerprint::kVivaldiDisplayName) {
+        if (vivaldi_token.empty())
+          continue;
+        bv.version = full ? vivaldi_token : GetMajorVersion(vivaldi_token);
+      }
+      out.push_back(std::move(bv));
+    }
+    list = std::move(out);
+  };
+  rebuild(metadata->brand_version_list, /*full=*/false);
+  rebuild(metadata->brand_full_version_list, /*full=*/true);
+  metadata->full_version = chrome_full;
+  for (const auto& bv : metadata->brand_full_version_list) {
+    if (bv.brand == ungoogled::fingerprint::kEdgeDisplayName ||
+        bv.brand == ungoogled::fingerprint::kOperaDisplayName ||
+        bv.brand == ungoogled::fingerprint::kVivaldiDisplayName) {
+      metadata->full_version = bv.version;
+    }
+  }
+
+  // The OS. Android first: its UA also says "Linux".
+  ungoogled::PersonaPlatform ua_platform = ungoogled::PersonaPlatform::kUnset;
+  if (user_agent.find("Android") != std::string::npos) {
+    ua_platform = ungoogled::PersonaPlatform::kAndroid;
+  } else if (user_agent.find("Windows NT") != std::string::npos) {
+    ua_platform = ungoogled::PersonaPlatform::kWindows;
+  } else if (user_agent.find("Macintosh") != std::string::npos) {
+    ua_platform = ungoogled::PersonaPlatform::kMacOS;
+  } else if (user_agent.find("CrOS") == std::string::npos &&
+             user_agent.find("Linux") != std::string::npos) {
+    ua_platform = ungoogled::PersonaPlatform::kLinux;
+  }
+  const char* ua_platform_name = "";
+  switch (ua_platform) {
+    case ungoogled::PersonaPlatform::kWindows:
+      ua_platform_name = ungoogled::fingerprint::kWindowsPlatform;
+      break;
+    case ungoogled::PersonaPlatform::kMacOS:
+      ua_platform_name = ungoogled::fingerprint::kMacOSPlatform;
+      break;
+    case ungoogled::PersonaPlatform::kLinux:
+      ua_platform_name = ungoogled::fingerprint::kLinuxPlatform;
+      break;
+    case ungoogled::PersonaPlatform::kAndroid:
+      ua_platform_name = ungoogled::fingerprint::kAndroidPlatform;
+      break;
+    default:
+      break;
+  }
+  if (ua_platform != ungoogled::PersonaPlatform::kUnset &&
+      metadata->platform != ua_platform_name) {
+    ApplyPlatformToMetadata(ua_platform, metadata);
+    if (ua_platform != ungoogled::PersonaPlatform::kAndroid) {
+      metadata->form_factors = {std::string(blink::kDesktopFormFactor)};
+    }
+  }
+  // An Android UA without "Mobile" is a tablet.
+  if (ua_platform == ungoogled::PersonaPlatform::kAndroid) {
+    metadata->mobile = user_agent.find(" Mobile") != std::string::npos;
+  }
+}
+
+void UpdateUserAgentMetadataFingerprint(UserAgentMetadata* metadata,
+                                        bool is_explicit_override,
+                                        const std::string& effective_user_agent) {
+  if (!metadata)
+    return;
+  // An explicit override (an automation client's userAgentMetadata, a UA-only override's
+  // derived metadata, an embedder's) is final: re-fingerprinting it here used to replace the
+  // brands a CDP client had set with the persona's.
+  if (is_explicit_override)
+    return;
+  UpdateUserAgentMetadataFingerprint(metadata);
+  ReconcileUserAgentMetadataWithUserAgent(effective_user_agent, metadata);
+}
+
+UserAgentMetadata UserAgentMetadataForUserAgentOverride(
+    UserAgentMetadata platform_default,
+    const std::string& user_agent) {
+  UpdateUserAgentMetadataFingerprint(&platform_default);
+  ReconcileUserAgentMetadataWithUserAgent(user_agent, &platform_default);
+  return platform_default;
+}
