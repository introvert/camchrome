+void ApplyPlatformToMetadata(ungoogled::PersonaPlatform platform_value,
+                             blink::UserAgentMetadata* metadata) {
+  using namespace ungoogled::fingerprint;
+  metadata->wow64 = false;
+  if (platform_value == ungoogled::PersonaPlatform::kWindows) {
+    metadata->platform = kWindowsPlatform;
+    metadata->platform_version = GetPlatformVersion("windows");
+    metadata->architecture = kX86Architecture;
+    metadata->bitness = "64";
+    metadata->model = "";
+    metadata->mobile = false;
+  } else if (platform_value == ungoogled::PersonaPlatform::kLinux) {
+    metadata->platform = kLinuxPlatform;
+    metadata->platform_version = GetPlatformVersion("linux");
+    metadata->architecture = kX86Architecture;
+    metadata->bitness = "64";
+    metadata->model = "";
+    metadata->mobile = false;
+  } else if (platform_value == ungoogled::PersonaPlatform::kMacOS) {
+    metadata->platform = kMacOSPlatform;
+    metadata->platform_version = GetPlatformVersion("macos");
+    metadata->architecture = kArmArchitecture;
+    metadata->bitness = "64";
+    metadata->model = "";
+    metadata->mobile = false;
+  } else if (platform_value == ungoogled::PersonaPlatform::kAndroid) {
+    // clearcote: the SINGLE source for the mobile bit. Setting metadata->mobile
