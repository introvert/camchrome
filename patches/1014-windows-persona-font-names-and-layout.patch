 #include "third_party/blink/public/platform/web_font_render_style.h"
 
 #include "build/build_config.h"
+#include "components/ungoogled/persona_profile.h"
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 #include "third_party/blink/renderer/platform/fonts/font_description.h"
 #include "third_party/blink/renderer/platform/web_test_support.h"
@@ -111,6 +112,22 @@
   font->setSubpixel(force_subpixel_positioning || use_subpixel_positioning);
 
   font->setLinearMetrics(use_subpixel_positioning == 1);
+
+  // camchrome (1014): text under a Windows or macOS persona is laid out the way DirectWrite and
+  // CoreText lay it out: unhinted, subpixel-positioned, linear advances. FreeType's hinted
+  // advances move on a coarser grid, so stepping the font size by 0.01 px changed a text's
+  // width on ~63% of steps where Windows changes it on nearly every step (Clearcote audit:
+  // "text layout uses the font scaler of the operating system claimed"). Linux and Android
+  // personas keep FreeType's own behaviour, which is theirs.
+  if (ungoogled::PersonaActive()) {
+    const ungoogled::PersonaPlatform platform = ungoogled::GetPersonaPlatform();
+    if (platform == ungoogled::PersonaPlatform::kWindows ||
+        platform == ungoogled::PersonaPlatform::kMacOS) {
+      font->setHinting(SkFontHinting::kNone);
+      font->setSubpixel(true);
+      font->setLinearMetrics(true);
+    }
+  }
 }
 
