+// camchrome (1014): the installed clone a cross-OS persona renders `name` through, for
+// local() lookups; "" when the host is the persona OS or the name is not one of its fonts.
+static std::string PersonaCloneForLocalName(const std::string& name) {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  const char* persona = ungoogled::PersonaPlatformName(ungoogled::GetPersonaPlatform());
+  if (!persona || persona[0] == 0 || std::string_view(persona) == "linux")
+    return std::string();
+  std::vector<std::string> fonts = GetPlatformFonts(persona);
+  if (!ungoogled::CurrentPersona().fonts.empty())
+    fonts = ungoogled::CurrentPersona().fonts;
+  if (!FontInListCaseInsensitive(fonts, name))
+    return std::string();
+  return MetricCompatibleSubstitute(name, "linux");
+#else
+  return std::string();
+#endif
+}
+
 sk_sp<SkTypeface> FontCache::CreateTypefaceFromUniqueName(
     const FontFaceCreationParams& creation_params) {
   const AtomicString& unique_name = creation_params.Family();
@@ -953,6 +985,19 @@
   DCHECK(unique_name_lookup);
   sk_sp<SkTypeface> uniquely_identified_font =
       unique_name_lookup->MatchUniqueName(unique_name);
+  // camchrome (1014): local("Calibri") under a cross-OS persona. The family path renders a
+  // persona font through its installed clone, but local() asked the host's unique-name table
+  // only, so a font that measured as present could not be loaded by name (on Windows both
+  // come from one DirectWrite collection). Only names on the persona OS's font list map;
+  // any other name still misses, as it would on that OS.
+  if (!uniquely_identified_font && !unique_name.empty()) {
+    const std::string clone = PersonaCloneForLocalName(unique_name.Utf8());
+    if (!clone.empty()) {
+      uniquely_identified_font =
+          unique_name_lookup->MatchUniqueName(
+              String::FromUtf8(base::as_byte_span(clone)));
+    }
+  }
   if (!uniquely_identified_font) {
     // Do not cache misses: where the lookup table is populated asynchronously,
     // a name that does not match yet may match once the table is ready.
