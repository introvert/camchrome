   }
 
+  // camchrome (1005): MediaCapabilities' powerEfficient and WebCodecs' prefer-hardware both
+  // read Chrome's GPU decoder check. The persona answers MediaCapabilities from its own codec
+  // table (147), so answer prefer-hardware from the same table; on a host without hardware
+  // decoders the real check said "unsupported" next to powerEfficient true.
+  if (hw_pref == HardwarePreference::kPreferHardware && ungoogled::PersonaActive()) {
+    const char* key = nullptr;
+    switch (video_type->codec) {
+      case media::VideoCodec::kH264: key = "h264"; break;
+      case media::VideoCodec::kVP8: key = "vp8"; break;
+      case media::VideoCodec::kVP9: key = "vp9"; break;
+      case media::VideoCodec::kAV1: key = "av1"; break;
+      case media::VideoCodec::kHEVC: key = "hevc"; break;
+      default: break;
+    }
+    const auto& codecs = ungoogled::CurrentPersona().media_codecs;
+    auto it = key ? codecs.find(key) : codecs.end();
+    if (it != codecs.end()) {
+      support->setSupported(it->second.supported && it->second.power_efficient);
+      return ToResolvedPromise<VideoDecoderSupport>(script_state, support);
+    }
+  }
