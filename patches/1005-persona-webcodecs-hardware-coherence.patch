camchrome: WebCodecs prefer-hardware agrees with MediaCapabilities powerEfficient.

Both answers come from Chrome's GPU decoder check. 147 answers MediaCapabilities from the
persona's codec table, while VideoDecoder.isConfigSupported({hardwareAcceleration:
"prefer-hardware"}) still asked the host, which on a machine without hardware decoders said
unsupported next to powerEfficient true (Clearcote audit: "MediaCapabilities powerEfficient
agrees with WebCodecs prefer-hardware"). Under a persona, prefer-hardware support for the
codecs in the persona's table is that table's supported && powerEfficient.

--- a/third_party/blink/renderer/modules/webcodecs/video_decoder.cc
+++ b/third_party/blink/renderer/modules/webcodecs/video_decoder.cc
@@ -4,6 +4,8 @@
 
 #include "third_party/blink/renderer/modules/webcodecs/video_decoder.h"
 
+#include "components/ungoogled/persona_profile.h"
+
 #include <algorithm>
 #include <utility>
 #include <vector>
@@ -11,6 +13,7 @@
 #include "base/containers/span.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/time/time.h"
+#include "media/base/video_codecs.h"
 #include "media/base/decoder_buffer.h"
 #include "media/base/limits.h"
 #include "media/base/media_util.h"
@@ -320,6 +323,28 @@
