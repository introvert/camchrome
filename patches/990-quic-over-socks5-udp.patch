+// camchrome: RSV FRAG ATYP=3 LEN NAME PORT. Returns bytes written, or 0 for a name that does not
+// fit the one-byte length field.
+size_t WriteHostHeader(const HostPortPair& destination,
+                       base::span<uint8_t> out) {
+  const std::string& host = destination.host();
+  if (host.empty() || host.size() > 255u) {
+    return 0u;
+  }
+  out[0] = 0x00;
+  out[1] = 0x00;
+  out[2] = 0x00;  // FRAG
+  out[3] = kAtypDomain;
+  out[4] = static_cast<uint8_t>(host.size());
+  out.subspan(5u, host.size()).copy_from(base::as_byte_span(host));
+  const size_t port_off = 5u + host.size();
+  out[port_off] = static_cast<uint8_t>(destination.port() >> 8);
+  out[port_off + 1u] = static_cast<uint8_t>(destination.port() & 0xff);
+  return port_off + 2u;
+}
