+bool SOCKS5UDPSocket::ProxyIsLoopback() const {
+  if (proxy_.host() == "localhost") {
+    return true;
+  }
+  IPAddress literal;
+  return literal.AssignFromIPLiteral(proxy_.host()) && literal.IsLoopback();
+}
+
+int SOCKS5UDPSocket::WaitForAssociation(CompletionOnceCallback callback) {
+  if (association_error_ != OK) {
+    return association_error_;
+  }
+  if (associated_) {
+    return OK;
+  }
+  association_waiters_.push_back(std::move(callback));
+  return ERR_IO_PENDING;
+}
+
+void SOCKS5UDPSocket::NotifyAssociationWaiters(int result) {
+  std::vector<CompletionOnceCallback> waiters =
+      std::move(association_waiters_);
+  association_waiters_.clear();
+  for (CompletionOnceCallback& cb : waiters) {
+    std::move(cb).Run(result);
+  }
+}
+
+void SOCKS5UDPSocket::StartResolveProxy() {
+  HostResolver::ResolveHostParameters parameters;
+  // The proxy's own name, not the origin's: resolving it locally leaks nothing the TCP proxy
+  // connection does not already resolve the same way.
+  resolve_request_ = resolver_->CreateRequest(
+      proxy_, NetworkAnonymizationKey(), handles::kInvalidNetworkHandle,
+      NetLogWithSource::Make(net_log_, NetLogSourceType::SOCKET), parameters);
+  const int rv = resolve_request_->Start(base::BindOnce(
+      &SOCKS5UDPSocket::OnProxyResolved, weak_factory_.GetWeakPtr()));
+  if (rv != ERR_IO_PENDING) {
+    OnProxyResolved(rv);
+  }
+}
+
+void SOCKS5UDPSocket::OnProxyResolved(int result) {
+  if (result != OK) {
+    // Fail closed: never fall back to sending the datagrams directly.
+    association_error_ = ERR_PROXY_CONNECTION_FAILED;
+    resolve_request_.reset();
+    FlushPending(association_error_);
+    NotifyAssociationWaiters(association_error_);
+    return;
+  }
+  AddressList addresses = resolve_request_->GetAddressResults();
+  resolve_request_.reset();
+  transport_ = std::make_unique<TCPClientSocket>(
+      std::move(addresses), nullptr /* socket_performance_watcher */,
+      nullptr /* network_quality_estimator */, net_log_, NetLogSource(),
+      handles::kInvalidNetworkHandle);
+  StartTransportConnect();
+}
+
+void SOCKS5UDPSocket::StartTransportConnect() {
+  const int connect_rv = transport_->Connect(base::BindOnce(
+      &SOCKS5UDPSocket::OnTransportConnected, weak_factory_.GetWeakPtr()));
+  if (connect_rv != ERR_IO_PENDING) {
+    OnTransportConnected(connect_rv);
+  }
+}
