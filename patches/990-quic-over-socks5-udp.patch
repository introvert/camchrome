+          description:
+            "When a SOCKS5 proxy is configured and --socks5-udp is passed, QUIC (HTTP/3) "
+            "packets to an origin reached through that proxy are carried over the proxy's "
+            "UDP ASSOCIATE relay, and a TCP control connection to the proxy holds the "
+            "association open."
+          trigger: "An HTTPS request to an origin that advertised HTTP/3."
+          data: "QUIC packets for the origin, framed per RFC 1928 section 7."
+          destination: OTHER
+          destination_other: "The SOCKS5 proxy the user configured."
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Enabled only when the user configures a SOCKS5 proxy and passes --socks5-udp."
+          policy_exception_justification: "Not implemented; controlled by user configuration."
+        })");
+
+// 198.18.0.0/15: RFC 2544 benchmarking space. Never routed on the Internet, not one of the
+// ranges Local Network Access treats as private, and never sent on the wire by us (it only
+// names a hostname inside this process).
+constexpr uint8_t kPlaceholderA = 198;
+constexpr uint8_t kPlaceholderB = 18;
+constexpr uint32_t kPlaceholderCount = 1u << 17;
+
+struct PlaceholderTable {
+  base::Lock lock;
+  std::map<std::string, uint32_t> by_host;
+  std::vector<std::string> by_index = std::vector<std::string>(kPlaceholderCount);
+  uint32_t next = 1;  // Skip 198.18.0.0.
+};
+
+PlaceholderTable& Table() {
+  static base::NoDestructor<PlaceholderTable> table;
+  return *table;
+}
+
+IPAddress PlaceholderAddress(uint32_t index) {
+  return IPAddress(kPlaceholderA, static_cast<uint8_t>(kPlaceholderB + (index >> 16)),
+                   static_cast<uint8_t>((index >> 8) & 0xff),
+                   static_cast<uint8_t>(index & 0xff));
+}
+
+}  // namespace
+
+bool Socks5UdpRelayEnabled() {
+  static const bool enabled = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    return cmd && cmd->HasSwitch("socks5-udp");
+  }();
+  return enabled;
+}
+
+std::optional<HostPortPair> Socks5UdpRelayProxyFor(const ProxyChain& chain) {
+  if (!Socks5UdpRelayEnabled() || !chain.IsValid() ||
+      !chain.is_single_proxy()) {
+    return std::nullopt;
+  }
+  const ProxyServer& proxy = chain.First();
+  if (proxy.scheme() != ProxyServer::SCHEME_SOCKS5) {
+    return std::nullopt;
+  }
+  return proxy.host_port_pair();
+}
+
+IPEndPoint Socks5UdpRelayPlaceholderFor(const HostPortPair& destination) {
+  PlaceholderTable& table = Table();
+  base::AutoLock lock(table.lock);
+  auto it = table.by_host.find(destination.host());
+  uint32_t index;
+  if (it != table.by_host.end()) {
+    index = it->second;
+  } else {
+    index = table.next;
+    table.next = (table.next + 1) % kPlaceholderCount;
+    if (table.next == 0) {
+      table.next = 1;
+    }
+    // Recycle the slot: forget the host that held it before.
+    if (!table.by_index[index].empty()) {
+      table.by_host.erase(table.by_index[index]);
+    }
+    table.by_index[index] = destination.host();
+    table.by_host[destination.host()] = index;
+  }
+  return IPEndPoint(PlaceholderAddress(index), destination.port());
+}
+
+std::optional<std::string> Socks5UdpRelayHostForPlaceholder(
+    const IPAddress& address) {
+  if (!address.IsIPv4()) {
+    return std::nullopt;
+  }
+  const base::span<const uint8_t> b = address.bytes();
+  if (b[0] != kPlaceholderA || (b[1] & 0xfe) != kPlaceholderB) {
+    return std::nullopt;
+  }
+  const uint32_t index = (static_cast<uint32_t>(b[1] - kPlaceholderB) << 16) |
+                         (static_cast<uint32_t>(b[2]) << 8) | b[3];
+  PlaceholderTable& table = Table();
+  base::AutoLock lock(table.lock);
+  if (index >= kPlaceholderCount || table.by_index[index].empty()) {
+    return std::nullopt;
+  }
+  return table.by_index[index];
+}
+
+SOCKS5UDPClientSocket::SOCKS5UDPClientSocket(const HostPortPair& proxy,
+                                             HostResolver* resolver,
+                                             net::NetLog* net_log,
+                                             const NetLogSource& source)
+    : proxy_(proxy),
+      resolver_(resolver),
+      net_log_ptr_(net_log),
+      net_log_(NetLogWithSource::Make(net_log, NetLogSourceType::UDP_SOCKET)) {
+}
+
+SOCKS5UDPClientSocket::~SOCKS5UDPClientSocket() = default;
+
+int SOCKS5UDPClientSocket::StartConnect(const IPEndPoint& address) {
+  if (connected_) {
+    return ERR_SOCKET_IS_CONNECTED;
+  }
+  if (!resolver_) {
+    return ERR_UNEXPECTED;
+  }
+  std::optional<std::string> host =
+      Socks5UdpRelayHostForPlaceholder(address.address());
+  if (host.has_value()) {
+    peer_host_ = HostPortPair(*host, address.port());
+  } else {
+    peer_host_.reset();
+  }
+
+  auto inner = std::make_unique<UDPServerSocket>(net_log_ptr_, NetLogSource());
+#if BUILDFLAG(IS_WIN)
+  inner->UseNonBlockingIO();
+#endif
+  relay_ = std::make_unique<SOCKS5UDPSocket>(
+      std::move(inner), proxy_, resolver_, net_log_ptr_,
+      kSocks5UdpQuicAnnotation);
+  // The local end only ever talks to the relay. Bind the family the proxy is reached over; a
+  // named proxy is assumed reachable over IPv4.
+  IPAddress proxy_literal;
+  const bool v6_proxy = proxy_literal.AssignFromIPLiteral(proxy_.host()) &&
+                        proxy_literal.IsIPv6();
+  const int rv = relay_->Listen(IPEndPoint(
+      v6_proxy ? IPAddress::IPv6AllZeros() : IPAddress::IPv4AllZeros(), 0));
+  if (rv != OK) {
+    relay_.reset();
+    return rv;
+  }
+  peer_ = address;
+  connected_ = true;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::Connect(const IPEndPoint& address) {
+  return StartConnect(address);
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingNetwork(handles::NetworkHandle network,
+                                               const IPEndPoint& address) {
+  return StartConnect(address);
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingDefaultNetwork(
+    const IPEndPoint& address) {
+  return StartConnect(address);
+}
+
+int SOCKS5UDPClientSocket::ConnectAsync(const IPEndPoint& address,
+                                        CompletionOnceCallback callback) {
+  const int rv = StartConnect(address);
+  if (rv != OK) {
+    return rv;
+  }
+  // Report success only once datagrams can flow: a proxy that refuses UDP ASSOCIATE then fails
+  // the QUIC job, and the request continues over the TCP tunnel.
+  return relay_->WaitForAssociation(std::move(callback));
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingNetworkAsync(
+    handles::NetworkHandle network,
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectAsync(address, std::move(callback));
+}
+
+int SOCKS5UDPClientSocket::ConnectUsingDefaultNetworkAsync(
+    const IPEndPoint& address,
+    CompletionOnceCallback callback) {
+  return ConnectAsync(address, std::move(callback));
+}
