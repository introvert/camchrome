+int SOCKS5UDPClientSocket::SetMulticastInterface(uint32_t interface_index) {
+  return ERR_NOT_IMPLEMENTED;
+}
+
+int SOCKS5UDPClientSocket::Read(IOBuffer* buf,
+                                int buf_len,
+                                CompletionOnceCallback callback) {
+  if (!connected_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  read_buf_ = buf;
+  read_buf_len_ = buf_len;
+  const int rv = DoRead();
+  if (rv == ERR_IO_PENDING) {
+    read_callback_ = std::move(callback);
+  } else {
+    read_buf_.reset();
+  }
+  return rv;
+}
+
+int SOCKS5UDPClientSocket::DoRead() {
+  for (;;) {
+    const int rv = relay_->RecvFrom(
+        read_buf_.get(), read_buf_len_, &read_source_,
+        base::BindOnce(&SOCKS5UDPClientSocket::OnReadComplete,
+                       weak_factory_.GetWeakPtr()));
+    // A datagram whose SOCKS5 framing we could not parse is dropped, not reported: QUIC treats a
+    // read error as fatal for the whole session, and one stray packet must not cost that.
+    if (rv == ERR_FAILED) {
+      continue;
+    }
+    return rv;
+  }
+}
+
+void SOCKS5UDPClientSocket::OnReadComplete(int result) {
+  if (result == ERR_FAILED) {
+    result = DoRead();
+    if (result == ERR_IO_PENDING) {
+      return;
+    }
+  }
+  read_buf_.reset();
+  if (read_callback_) {
+    std::move(read_callback_).Run(result);
+  }
+}
+
+int SOCKS5UDPClientSocket::Write(
+    IOBuffer* buf,
+    int buf_len,
+    CompletionOnceCallback callback,
+    const NetworkTrafficAnnotationTag& traffic_annotation) {
+  if (!connected_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  if (peer_host_.has_value()) {
+    return relay_->SendToHost(buf, buf_len, *peer_host_, std::move(callback));
+  }
+  return relay_->SendTo(buf, buf_len, peer_, std::move(callback));
+}
+
+int SOCKS5UDPClientSocket::SetReceiveBufferSize(int32_t size) {
+  return relay_ ? relay_->SetReceiveBufferSize(size)
+                : ERR_SOCKET_NOT_CONNECTED;
+}
+
+int SOCKS5UDPClientSocket::SetSendBufferSize(int32_t size) {
+  return relay_ ? relay_->SetSendBufferSize(size) : ERR_SOCKET_NOT_CONNECTED;
+}
+
+void SOCKS5UDPClientSocket::Close() {
+  weak_factory_.InvalidateWeakPtrs();
+  read_buf_.reset();
+  read_callback_.Reset();
+  if (relay_) {
+    relay_->Close();
+  }
+  connected_ = false;
+}
+
+int SOCKS5UDPClientSocket::GetPeerAddress(IPEndPoint* address) const {
+  if (!connected_) {
+    return ERR_SOCKET_NOT_CONNECTED;
+  }
+  *address = peer_;
+  return OK;
+}
+
+int SOCKS5UDPClientSocket::GetLocalAddress(IPEndPoint* address) const {
+  return relay_ ? relay_->GetLocalAddress(address) : ERR_SOCKET_NOT_CONNECTED;
+}
+
+void SOCKS5UDPClientSocket::UseNonBlockingIO() {
+  // Applied to the inner socket when it is created (Windows only; a no-op elsewhere).
+}
+
+int SOCKS5UDPClientSocket::SetDoNotFragment() {
+  return relay_ ? relay_->SetDoNotFragment() : ERR_SOCKET_NOT_CONNECTED;
+}
+
+int SOCKS5UDPClientSocket::SetRecvTos() {
+  return relay_ ? relay_->SetRecvTos() : ERR_SOCKET_NOT_CONNECTED;
+}
+
+int SOCKS5UDPClientSocket::SetTos(DiffServCodePoint dscp, EcnCodePoint ecn) {
+  return relay_ ? relay_->SetTos(dscp, ecn) : ERR_SOCKET_NOT_CONNECTED;
+}
+
+void SOCKS5UDPClientSocket::SetMsgConfirm(bool confirm) {
+  if (relay_) {
+    relay_->SetMsgConfirm(confirm);
+  }
+}
+
+const NetLogWithSource& SOCKS5UDPClientSocket::NetLog() const {
+  return net_log_;
+}
