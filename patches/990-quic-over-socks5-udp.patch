+std::unique_ptr<DatagramClientSocket> QuicSessionPool::CreateSocketForChain(
+    const ProxyChain& proxy_chain,
+    handles::NetworkHandle target_network,
+    const NetLogWithSource& net_log) {
+  // camchrome: a SOCKS5 chain only reaches session creation when --socks5-udp relays it (see
+  // RequestSession), and then every datagram must go through the relay. Never fall back to a
+  // direct socket: that would send the origin our real address.
+  std::optional<HostPortPair> relay = Socks5UdpRelayProxyFor(proxy_chain);
+  if (relay.has_value()) {
+    return std::make_unique<SOCKS5UDPClientSocket>(
+        *relay, host_resolver_, net_log.net_log(), net_log.source());
+  }
+  return CreateSocket(target_network, net_log.net_log(), net_log.source());
+}
