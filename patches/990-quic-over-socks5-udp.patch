+namespace {
+
+int g_passed = 0;
+int g_failed = 0;
+
+void Report(const std::string& name, bool ok, const std::string& detail = "") {
+  if (ok) {
+    ++g_passed;
+    printf("  PASS  %s\n", name.c_str());
+  } else {
+    ++g_failed;
+    printf("  FAIL  %s\n            %s\n", name.c_str(), detail.c_str());
+  }
+  fflush(stdout);
+}
+
+// A minimal stand-in for Waiter, which lives in //net:test_support (and
+// that target drags in test fonts the source tarball does not ship).
+class Waiter {
+ public:
+  net::CompletionOnceCallback callback() {
+    return base::BindOnce(&Waiter::Done, base::Unretained(this));
+  }
+  int GetResult(int rv) {
+    if (rv != net::ERR_IO_PENDING) {
+      return rv;
+    }
+    if (!have_result_) {
+      loop_.Run();
+    }
+    return result_;
+  }
+
+ private:
+  void Done(int rv) {
+    result_ = rv;
+    have_result_ = true;
+    loop_.Quit();
+  }
+  base::RunLoop loop_;
+  int result_ = 0;
+  bool have_result_ = false;
+};
+
+std::string Describe(int rv) {
+  return std::to_string(rv) +
+         (rv < 0 ? " (" + net::ErrorToShortString(rv) + ")" : "");
+}
+
+scoped_refptr<net::IOBufferWithSize> Bytes(const std::string& s) {
+  auto buf = base::MakeRefCounted<net::IOBufferWithSize>(s.size());
+  buf->span().copy_from(base::as_byte_span(s));
+  return buf;
+}
+
+// Writes `payload` and reads one datagram back. Returns the read result; fills `got`.
+int Exchange(net::DatagramClientSocket* sock,
+             const std::string& payload,
+             std::string* got) {
+  auto out = Bytes(payload);
+  Waiter write_cb;
+  int rv = sock->Write(out.get(), static_cast<int>(payload.size()),
+                       write_cb.callback(), TRAFFIC_ANNOTATION_FOR_TESTS);
+  rv = write_cb.GetResult(rv);
+  if (rv < 0) {
+    return rv;
+  }
+  auto in = base::MakeRefCounted<net::IOBufferWithSize>(2048);
+  Waiter read_cb;
+  rv = sock->Read(in.get(), in->size(), read_cb.callback());
+  rv = read_cb.GetResult(rv);
+  if (rv > 0) {
+    *got = std::string(reinterpret_cast<const char*>(in->span().data()),
+                       static_cast<size_t>(rv));
+  }
+  return rv;
+}
+
+void PureChecks() {
+  printf("placeholders and chain selection\n");
+  const net::IPEndPoint a =
+      net::Socks5UdpRelayPlaceholderFor(net::HostPortPair("example.com", 443));
+  const net::IPEndPoint a2 =
+      net::Socks5UdpRelayPlaceholderFor(net::HostPortPair("example.com", 8443));
+  const net::IPEndPoint b =
+      net::Socks5UdpRelayPlaceholderFor(net::HostPortPair("example.org", 443));
+  Report("a host maps to one stable placeholder address",
+         a.address() == a2.address() && a.port() == 443 && a2.port() == 8443,
+         a.ToString() + " vs " + a2.ToString());
+  Report("different hosts get different placeholders",
+         a.address() != b.address(), a.ToString() + " vs " + b.ToString());
+  Report("placeholders sit in 198.18.0.0/15",
+         a.address().IsIPv4() && a.address().bytes()[0] == 198 &&
+             (a.address().bytes()[1] & 0xfe) == 18,
+         a.ToString());
+  const std::optional<std::string> back =
+      net::Socks5UdpRelayHostForPlaceholder(a.address());
+  Report("a placeholder maps back to its host",
+         back.has_value() && *back == "example.com", back.value_or("(none)"));
+  net::IPAddress real;
+  CHECK(real.AssignFromIPLiteral("93.184.216.34"));
+  Report("a real address is not taken for a placeholder",
+         !net::Socks5UdpRelayHostForPlaceholder(real).has_value());
+
+  const net::ProxyChain socks5(net::ProxyServer::SCHEME_SOCKS5,
+                               net::HostPortPair("proxy.example", 1080));
+  const net::ProxyChain socks4(net::ProxyServer::SCHEME_SOCKS4,
+                               net::HostPortPair("proxy.example", 1080));
+  const net::ProxyChain https(net::ProxyServer::SCHEME_HTTPS,
+                              net::HostPortPair("proxy.example", 443));
+  const std::optional<net::HostPortPair> relay =
+      net::Socks5UdpRelayProxyFor(socks5);
+  Report("a single SOCKS5 proxy is relayed (with --socks5-udp)",
+         relay.has_value() && relay->host() == "proxy.example" &&
+             relay->port() == 1080);
+  Report("direct, SOCKS4 and HTTPS chains are not",
+         !net::Socks5UdpRelayProxyFor(net::ProxyChain::Direct()) &&
+             !net::Socks5UdpRelayProxyFor(socks4) &&
+             !net::Socks5UdpRelayProxyFor(https));
+}
+
+void RelayChecks(net::HostResolver* resolver,
+                 uint16_t proxy_port,
+                 uint16_t refusing_port,
+                 uint16_t echo_port) {
+  printf("relay round trips\n");
+  const net::HostPortPair ip_proxy("127.0.0.1", proxy_port);
+  const net::HostPortPair named_proxy("localhost", proxy_port);
+  // The origin is named: the proxy must resolve "localhost", the client never does.
+  const net::IPEndPoint origin =
+      net::Socks5UdpRelayPlaceholderFor(net::HostPortPair("localhost", echo_port));
+
+  {
+    net::SOCKS5UDPClientSocket sock(ip_proxy, resolver, nullptr,
+                                    net::NetLogSource());
+    Waiter connect_cb;
+    int rv = connect_cb.GetResult(sock.ConnectAsync(origin, connect_cb.callback()));
+    Report("ConnectAsync completes once the association is up", rv == net::OK,
+           Describe(rv));
+    std::string got;
+    rv = Exchange(&sock, "quic-initial", &got);
+    Report("a datagram to a NAMED origin round-trips (ATYP=DOMAINNAME)",
+           got == "echo:quic-initial", Describe(rv) + " got='" + got + "'");
+    rv = Exchange(&sock, "second", &got);
+    Report("the association carries further datagrams", got == "echo:second",
+           Describe(rv) + " got='" + got + "'");
+    net::IPEndPoint peer;
+    Report("GetPeerAddress reports the placeholder, not a resolved address",
+           sock.GetPeerAddress(&peer) == net::OK && peer == origin,
+           peer.ToString());
+  }
+  {
+    net::SOCKS5UDPClientSocket sock(named_proxy, resolver, nullptr,
+                                    net::NetLogSource());
+    Waiter connect_cb;
+    int rv = connect_cb.GetResult(sock.ConnectAsync(origin, connect_cb.callback()));
+    std::string got;
+    if (rv == net::OK) {
+      rv = Exchange(&sock, "named-proxy", &got);
+    }
+    Report("a proxy given by HOSTNAME is resolved and relayed (no direct fallback)",
+           got == "echo:named-proxy", Describe(rv) + " got='" + got + "'");
+  }
+  {
+    // The synchronous QUIC path: Connect() returns before the association is up, so the first
+    // write must be queued and flushed, not lost.
+    net::SOCKS5UDPClientSocket sock(ip_proxy, resolver, nullptr,
+                                    net::NetLogSource());
+    int rv = sock.Connect(origin);
+    std::string got;
+    if (rv == net::OK) {
+      rv = Exchange(&sock, "queued", &got);
+    }
+    Report("Connect() then an immediate write: the queued datagram is delivered",
+           got == "echo:queued", Describe(rv) + " got='" + got + "'");
+  }
+  {
+    net::SOCKS5UDPClientSocket sock(net::HostPortPair("127.0.0.1", refusing_port),
+                                    resolver, nullptr, net::NetLogSource());
+    Waiter connect_cb;
+    const int rv =
+        connect_cb.GetResult(sock.ConnectAsync(origin, connect_cb.callback()));
+    Report("a proxy that refuses UDP ASSOCIATE fails the connect (QUIC falls back to TCP)",
+           rv < 0, Describe(rv));
+  }
+  {
+    // Port 9 on loopback: nothing listens, so the control connection is refused.
+    net::SOCKS5UDPClientSocket sock(net::HostPortPair("127.0.0.1", 9), resolver,
+                                    nullptr, net::NetLogSource());
+    Waiter connect_cb;
+    const int rv =
+        connect_cb.GetResult(sock.ConnectAsync(origin, connect_cb.callback()));
+    Report("an unreachable proxy fails the connect instead of going direct", rv < 0,
+           Describe(rv));
+  }
+}
