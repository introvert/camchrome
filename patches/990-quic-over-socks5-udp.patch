+int main(int argc, char** argv) {
+  base::AtExitManager exit_manager;
+  base::CommandLine::Init(argc, argv);
+  // The relay is opt-in; the checks run as the browser would with the switch set.
+  base::CommandLine::ForCurrentProcess()->AppendSwitch("socks5-udp");
+  base::SingleThreadTaskExecutor io_task_executor(base::MessagePumpType::IO);
+  // The host resolver runs getaddrinfo() on the thread pool and watches the network.
+  base::ThreadPoolInstance::CreateAndStartWithDefaultParams("selftest");
+  std::unique_ptr<net::NetworkChangeNotifier> network_change_notifier =
+      net::NetworkChangeNotifier::CreateIfNeeded();
+
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  int proxy_port = 0, refusing_port = 0, echo_port = 0;
+  const bool have_ports =
+      base::StringToInt(cmd->GetSwitchValueASCII("proxy-port"), &proxy_port) &&
+      base::StringToInt(cmd->GetSwitchValueASCII("refusing-proxy-port"),
+                        &refusing_port) &&
+      base::StringToInt(cmd->GetSwitchValueASCII("echo-port"), &echo_port);
+
+  PureChecks();
+  if (have_ports) {
+    std::unique_ptr<net::HostResolver> resolver =
+        net::HostResolver::CreateStandaloneResolver(nullptr);
+    RelayChecks(resolver.get(), static_cast<uint16_t>(proxy_port),
+                static_cast<uint16_t>(refusing_port),
+                static_cast<uint16_t>(echo_port));
+  } else {
+    printf("relay round trips skipped: pass --proxy-port, --refusing-proxy-port and "
+           "--echo-port (tools/socks5_udp_proxy.py --run-selftest-binary does)\n");
+  }
+
+  printf("\n%d passed, %d failed\n", g_passed, g_failed);
+  return g_failed ? 1 : 0;
+}
