 // camchrome (1015): glyph coverage levels for 8-bit masks (0 = FreeType's own).
 namespace {
 std::atomic<int> gSkFreeTypeCoverageLevels{0};
 int SkFreeTypeCoverageLevels() {
-    return gSkFreeTypeCoverageLevels.load(std::memory_order_relaxed);
+    // camchrome (1018): or from CAMCHROME_FT_COVERAGE_LEVELS, which the browser sets for a
+    // Windows persona before any child process starts; the GPU process, which rasterises the
+    // glyphs of an accelerated canvas, gets no fingerprint switches.
+    static const int kFromEnv = [] {
+        const char* v = getenv("CAMCHROME_FT_COVERAGE_LEVELS");
+        return v ? atoi(v) : 0;
+    }();
+    const int set = gSkFreeTypeCoverageLevels.load(std::memory_order_relaxed);
+    return set ? set : kFromEnv;
+}
+
+// camchrome (1018): advances from design units scaled by the exact float size, as DirectWrite
+// computes them, instead of FreeType's linear advance at a size quantized to 1/64 px (26.6).
+bool SkFreeTypeFloatAdvances() {
+    static const bool kOn = [] {
+        const char* v = getenv("CAMCHROME_FT_FLOAT_ADVANCES");
+        return v && v[0] == '1';
+    }();
+    return kOn;
 }
 }  // namespace
 
