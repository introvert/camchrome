+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_DEVICE_ORIENTATION_HELD_DEVICE_SENSOR_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_DEVICE_ORIENTATION_HELD_DEVICE_SENSOR_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/modules/modules_export.h"
+
+namespace blink {
+
+// camchrome (992): readings of a phone held in a hand, for an Android persona
+// on a machine that has no orientation or motion sensors.
+//
+// A desktop answers deviceorientation with one event whose alpha/beta/gamma
+// are all null and devicemotion with null vectors; a phone fires a steady
+// stream of small, ever-changing readings. The model is a portrait handset
+// tilted towards the face (posture picked from the persona seed) with slow
+// arm sway, faster physiological tremor and per-sample sensor noise, then
+// quantised the way Chrome's sensor service rounds real readings (0.1 degree
+// for Euler angles, 0.1 m/s^2 for acceleration, 0.1 degree/s for rotation).
+// Gravity, rotation rate and the angles all come from the same motion, so
+// they agree with each other the way a real device's do.
+struct HeldDeviceReading {
+  // deviceorientation, degrees.
+  double alpha = 0;
+  double beta = 0;
+  double gamma = 0;
+  // devicemotion, m/s^2 and degrees/s.
+  double accel_x = 0, accel_y = 0, accel_z = 0;
+  double accel_g_x = 0, accel_g_y = 0, accel_g_z = 0;
+  double rotation_alpha = 0, rotation_beta = 0, rotation_gamma = 0;
+};
+
+// True when the active persona is a phone (--fingerprint-platform=android),
+// i.e. when the pumps should fall back to HeldDeviceReadingNow() instead of
+// reporting "no sensor".
+MODULES_EXPORT bool ShouldSynthesizeHeldDevice();
+
+// The reading at the current time. Calls a few milliseconds apart move
+// smoothly; the posture is stable for a persona.
+MODULES_EXPORT HeldDeviceReading HeldDeviceReadingNow();
+
+// The same, at `seconds` on the model's clock and for `seed`; exposed for the
+// persona validator and tests.
+MODULES_EXPORT HeldDeviceReading HeldDeviceReadingAt(double seconds,
+                                                     uint64_t seed);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_DEVICE_ORIENTATION_HELD_DEVICE_SENSOR_H_
