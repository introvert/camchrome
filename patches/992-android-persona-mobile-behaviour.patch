+// camchrome (992): an Android persona on a macOS host. The handset's named families (Roboto,
+// sans-serif-condensed, Droid Sans Mono, ...) are not installed on a Mac, and the Linux clones
+// MetricCompatibleSubstitute() names are not either, so each family a phone answers to renders
+// through the closest font every macOS install ships (/System/Library/Fonts, Supplemental
+// included). Returns "" for a family the host has itself (Arial, Georgia, Courier New, ...).
+static std::string MacHostSubstituteForAndroid(const std::string& family) {
+  struct Sub {
+    const char* persona_font;
+    const char* mac_font;
+  };
+  static const Sub kSubs[] = {
+      {"sans-serif", "Helvetica Neue"},
+      {"sans-serif-medium", "Helvetica Neue"},
+      {"sans-serif-light", "Helvetica Neue"},
+      {"sans-serif-thin", "Helvetica Neue"},
+      {"sans-serif-black", "Helvetica Neue"},
+      {"sans-serif-smallcaps", "Helvetica Neue"},
+      {"Roboto", "Helvetica Neue"},
+      {"source-sans-pro", "Helvetica Neue"},
+      {"source-sans-pro-semi-bold", "Helvetica Neue"},
+      {"Carrois Gothic SC", "Helvetica Neue"},
+      {"sans-serif-condensed", "Arial Narrow"},
+      {"sans-serif-condensed-medium", "Arial Narrow"},
+      {"sans-serif-condensed-light", "Arial Narrow"},
+      {"monospace", "Menlo"},
+      {"serif-monospace", "Courier New"},
+      {"sans-serif-monospace", "Menlo"},
+      {"Droid Sans Mono", "Menlo"},
+      {"Cutive Mono", "Courier New"},
+      {"serif", "Times New Roman"},
+      {"Noto Serif", "Georgia"},
+      {"Goudy", "Georgia"},
+      {"ITC Stone Serif", "Georgia"},
+      {"fantasy", "Times New Roman"},
+      {"casual", "Comic Sans MS"},
+      {"cursive", "Comic Sans MS"},
+      {"Coming Soon", "Comic Sans MS"},
+      {"Dancing Script", "Comic Sans MS"},
+  };
+  for (const Sub& sub : kSubs) {
+    if (base::EqualsCaseInsensitiveASCII(sub.persona_font, family)) {
+      return std::string(sub.mac_font);
+    }
+  }
+  return std::string();
+}
