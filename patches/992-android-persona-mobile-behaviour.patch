+
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kTwoPi = 2 * kPi;
+constexpr double kGravity = 9.80665;
+// The sensor service's rounding of real readings
+// (services/device/generic_sensor/platform_sensor_util.h).
+constexpr double kEulerRounding = 0.1;          // degrees
+constexpr double kAccelerationRounding = 0.1;   // m/s^2
+constexpr double kRotationRounding = 0.1;       // degrees/s
+// Readings are produced on a 60 Hz grid like the pump's timer, so noise is
+// per sample and not per call.
+constexpr double kSampleHz = 60.0;
+
+uint64_t Mix(uint64_t x) {
+  x += 0x9e3779b97f4a7c15ULL;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+  return x ^ (x >> 31);
+}
+
+// Uniform in [0, 1).
+double Unit(uint64_t seed, uint64_t salt) {
+  return static_cast<double>(Mix(seed ^ Mix(salt)) >> 11) * 0x1.0p-53;
+}
+
+// Roughly normal, mean 0, standard deviation 1 (Irwin-Hall of four).
+double Noise(uint64_t seed, uint64_t sample, uint64_t channel) {
+  double sum = 0;
+  for (uint64_t k = 0; k < 4; ++k) {
+    sum += Unit(seed, (sample << 8) ^ (channel << 3) ^ k);
+  }
+  return (sum - 2.0) * std::sqrt(3.0);
+}
+
+double Round(double value, double multiple) {
+  // + 0.0 turns a rounded -0 into 0, which is what a real reading reports.
+  return std::round(value / multiple) * multiple + 0.0;
+}
+
+// One axis of motion: a sum of sines (slow arm sway, breathing, tremor).
+struct Wave {
+  double amplitude;  // degrees
+  double hz;
+};
+
+// Value and time derivative (per second) of a wave sum with seeded phases.
+void WaveSum(const Wave* waves,
+             size_t count,
+             double t,
+             uint64_t seed,
+             uint64_t axis,
+             double* value,
+             double* rate) {
+  *value = 0;
+  *rate = 0;
+  for (size_t i = 0; i < count; ++i) {
+    const double phase = kTwoPi * Unit(seed, (axis << 4) | i);
+    // Each persona's hand is a little different: +-15% on every frequency.
+    const double hz = waves[i].hz * (0.85 + 0.3 * Unit(seed, 0x100 + (axis << 4) + i));
+    const double w = kTwoPi * hz;
+    *value += waves[i].amplitude * std::sin(w * t + phase);
+    *rate += waves[i].amplitude * w * std::cos(w * t + phase);
+  }
+}
+
+constexpr std::array<Wave, 4> kBetaWaves = {{
+    {2.2, 0.07}, {0.9, 0.31}, {0.05, 8.6}, {0.025, 11.2}}};
+constexpr std::array<Wave, 4> kGammaWaves = {{
+    {1.8, 0.09}, {0.7, 0.27}, {0.04, 9.1}, {0.02, 10.4}}};
+constexpr std::array<Wave, 3> kAlphaWaves = {{
+    {3.5, 0.04}, {0.8, 0.23}, {0.03, 9.7}}};
+// Hand translation shows up as linear acceleration of a few cm/s^2.
+constexpr std::array<Wave, 3> kLinearWaves = {{
+    {0.035, 0.6}, {0.02, 1.7}, {0.012, 9.0}}};
+
+}  // namespace
+
+bool ShouldSynthesizeHeldDevice() {
+  return ungoogled::PersonaActive() && ungoogled::CurrentPersona().mobile;
+}
+
+HeldDeviceReading HeldDeviceReadingAt(double t, uint64_t seed) {
+  // Posture: portrait, tilted 35-65 degrees towards the face, a slight roll,
+  // any compass heading.
+  const double beta0 = 35.0 + 30.0 * Unit(seed, 1);
+  const double gamma0 = -6.0 + 12.0 * Unit(seed, 2);
+  const double alpha0 = 360.0 * Unit(seed, 3);
+  const uint64_t sample = static_cast<uint64_t>(std::floor(t * kSampleHz));
+
+  double beta, beta_rate, gamma, gamma_rate, alpha, alpha_rate;
+  WaveSum(kBetaWaves.data(), kBetaWaves.size(), t, seed, 1, &beta, &beta_rate);
+  WaveSum(kGammaWaves.data(), kGammaWaves.size(), t, seed, 2, &gamma,
+          &gamma_rate);
+  WaveSum(kAlphaWaves.data(), kAlphaWaves.size(), t, seed, 3, &alpha,
+          &alpha_rate);
+  beta += beta0 + 0.04 * Noise(seed, sample, 1);
+  gamma += gamma0 + 0.04 * Noise(seed, sample, 2);
+  alpha = std::fmod(alpha0 + alpha + 0.04 * Noise(seed, sample, 3), 360.0);
+  if (alpha < 0) {
+    alpha += 360.0;
+  }
+
+  HeldDeviceReading r;
+  r.alpha = Round(alpha, kEulerRounding);
+  r.beta = Round(beta, kEulerRounding);
+  r.gamma = Round(gamma, kEulerRounding);
+  if (r.alpha >= 360.0) {
+    r.alpha -= 360.0;
+  }
+
+  // Gyroscope: the same motion's angular rate plus gyro noise.
+  r.rotation_alpha = Round(alpha_rate + 0.15 * Noise(seed, sample, 4),
+                           kRotationRounding);
+  r.rotation_beta = Round(beta_rate + 0.15 * Noise(seed, sample, 5),
+                          kRotationRounding);
+  r.rotation_gamma = Round(gamma_rate + 0.15 * Noise(seed, sample, 6),
+                           kRotationRounding);
+
+  // Linear acceleration (gravity removed): hand translation plus noise.
+  double lx, ly, lz, unused;
+  WaveSum(kLinearWaves.data(), kLinearWaves.size(), t, seed, 7, &lx, &unused);
+  WaveSum(kLinearWaves.data(), kLinearWaves.size(), t, seed, 8, &ly, &unused);
+  WaveSum(kLinearWaves.data(), kLinearWaves.size(), t, seed, 9, &lz, &unused);
+  lx += 0.03 * Noise(seed, sample, 7);
+  ly += 0.03 * Noise(seed, sample, 8);
+  lz += 0.03 * Noise(seed, sample, 9);
+
+  // Gravity in device coordinates from the (unrounded) tilt, Android's axes:
+  // flat face up is (0, 0, +g), upright portrait is (0, +g, 0), and tilting
+  // the right edge down (positive gamma) makes x negative.
+  const double b = beta * kPi / 180.0;
+  const double g = gamma * kPi / 180.0;
+  const double gx = -kGravity * std::cos(b) * std::sin(g);
+  const double gy = kGravity * std::sin(b);
+  const double gz = kGravity * std::cos(b) * std::cos(g);
+
+  r.accel_x = Round(lx, kAccelerationRounding);
+  r.accel_y = Round(ly, kAccelerationRounding);
+  r.accel_z = Round(lz, kAccelerationRounding);
+  r.accel_g_x = Round(gx + lx, kAccelerationRounding);
+  r.accel_g_y = Round(gy + ly, kAccelerationRounding);
+  r.accel_g_z = Round(gz + lz, kAccelerationRounding);
+  return r;
+}
+
+HeldDeviceReading HeldDeviceReadingNow() {
+  const ungoogled::PersonaProfile& persona = ungoogled::CurrentPersona();
+  // Monotonic clock since boot, the same in every renderer of the session, so
+  // two frames listening at once see the same phone.
+  const double t = (base::TimeTicks::Now() - base::TimeTicks()).InSecondsF();
+  return HeldDeviceReadingAt(t, Mix(persona.persona_seed ^ 0x992));
+}
+
+}  // namespace blink
