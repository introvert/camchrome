+void RenderWidgetHostImpl::MaybeEnablePersonaTouchEmulation() {
+  // camchrome (992): an Android persona behaves like a phone, not only answers
+  // like one. Mouse input on web content becomes touch input with the mobile
+  // gesture config, the path DevTools device mode uses
+  // (Emulation.setEmitTouchEventsForMouse): pages see touchstart/touchend,
+  // pointerType "touch" and tap-synthesised clicks. The emulator is per
+  // WebContents and is switched on at the first mouse event that reaches one of
+  // its widgets, so it covers every navigation and out-of-process frame.
+  // Browser UI pages (chrome://, devtools://, extensions) keep the mouse, and an
+  // emulator DevTools already runs in another mode (e.g. after a raw
+  // Input.dispatchTouchEvent) is left alone.
+  if (!ungoogled::PersonaActive() || !ungoogled::CurrentPersona().mobile ||
+      !frame_tree() || !frame_tree()->GetMainFrame()) {
+    return;
+  }
+  const GURL& url = frame_tree()->GetMainFrame()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsFile() &&
+      !url.SchemeIs(url::kDataScheme) && !url.SchemeIsBlob() &&
+      !url.IsAboutBlank()) {
+    return;
+  }
+  TouchEmulatorImpl* touch_emulator =
+      GetTouchEmulator(/*create_if_necessary=*/true);
+  if (touch_emulator && !touch_emulator->IsEnabled()) {
+    touch_emulator->Enable(input::TouchEmulator::Mode::kEmulatingTouchFromMouse,
+                           ui::GestureProviderConfigType::GENERIC_MOBILE);
+  }
+}
