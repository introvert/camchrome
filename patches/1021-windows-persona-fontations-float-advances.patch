+        // camchrome (1021): advances as DirectWrite computes them, from design units scaled by
+        // the exact float size. Read at ppem == unitsPerEm (a scale of exactly 1) and scaled
+        // here, so the font size reaches the advance without passing through a fixed-point
+        // size grid: stepping the size by 0.01 px then changes a text's width on nearly every
+        // step, as on Windows. Set by the browser for a Windows persona
+        // (CAMCHROME_FT_FLOAT_ADVANCES); unhinted metrics only.
+        if (doLinearMetrics && CamchromeFloatAdvances()) {
+            const uint16_t upem = fontations_ffi::units_per_em_or_zero(fBridgeFontRef);
+            if (upem > 0) {
