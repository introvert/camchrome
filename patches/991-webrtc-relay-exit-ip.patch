+  // camchrome: tell WebRTC in the renderer that its UDP really leaves through the SOCKS5 proxy's
+  // relay (--socks5-udp with a SOCKS5 --proxy-server; the network service relays every P2P
+  // socket). Only then is it safe to let real STUN run so the server-reflexive candidate becomes
+  // the proxy's exit IP with no --webrtc-ip. The proxy URL itself stays out of the renderer.
+  if (browser_command_line.HasSwitch("socks5-udp") &&
