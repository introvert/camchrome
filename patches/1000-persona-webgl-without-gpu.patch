camchrome: a persona always has WebGL, also on a machine without a GPU.

Since Chrome 137, WebGL no longer falls back to SwiftShader on its own: a server, VM or Xvfb
session without a usable GPU reports getContext("webgl") === null and no WebGPU adapter. No real
visitor lacks WebGL, so that alone marks the browser. The persona patches already present the
persona GPU (strings, limits, extensions, precision) over SwiftShader, so whenever a persona is
active the browser opts into SwiftShader (--enable-unsafe-swiftshader), unless
--disable-software-rasterizer says otherwise. With a working GPU nothing changes: SwiftShader
is only used when hardware GL is unavailable.

--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -35,6 +35,7 @@
 #include "chrome/browser/browser_process.h"
 #include "chrome/browser/browser_process_impl.h"
 #include "chrome/browser/chrome_browser_main_extra_parts.h"
+#include "components/ungoogled/persona_profile.h"
 #include "chrome/browser/component_updater/registration.h"
 #include "chrome/browser/enterprise/browser_management/management_service_factory.h"
 #include "chrome/browser/enterprise/chrome_browser_main_extra_parts_enterprise.h"
@@ -1412,6 +1413,16 @@
   if (local_state->GetBoolean(prefs::kEnableUnsafeSwiftShader)) {
     command_line->AppendSwitch(switches::kEnableUnsafeSwiftShader);
   }
+  // camchrome (1000): a persona always has WebGL. Since Chrome 137 a machine without a usable
+  // GPU (a server, a VM, Xvfb) gets no WebGL at all unless SwiftShader is opted into, and no
+  // real visitor lacks WebGL. The persona already reports its own GPU strings, limits and
+  // extensions over SwiftShader (070/955/968/969), so opt in whenever a persona is active.
+  // With a working GPU this changes nothing: SwiftShader is only the fallback.
+  if (ungoogled::PersonaActive() &&
+      !command_line->HasSwitch(switches::kDisableSoftwareRasterizer) &&
+      !command_line->HasSwitch(switches::kEnableUnsafeSwiftShader)) {
+    command_line->AppendSwitch(switches::kEnableUnsafeSwiftShader);
+  }
 
