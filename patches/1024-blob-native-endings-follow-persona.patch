camchrome: Blob "native" line endings follow the persona's OS.

new Blob(["a\nb"], {endings: "native"}) is CRLF only in Chrome on Windows. A Windows persona on a
Linux host wrote LF (Clearcote's stealth gate checks this). With a persona the claimed OS decides:
CRLF for Windows, LF otherwise; without one the build's own OS does, as before.

--- a/third_party/blink/renderer/platform/blob/blob_data.cc
+++ b/third_party/blink/renderer/platform/blob/blob_data.cc
@@ -55,6 +55,7 @@
 #include "third_party/blink/renderer/platform/wtf/thread_specific.h"
 #include "third_party/blink/renderer/platform/wtf/uuid.h"
 #include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "components/ungoogled/persona_profile.h"
 
 namespace blink {
 
@@ -161,6 +162,40 @@
       DataElementBlob::New(data_handle->CloneBlobRemote(), offset, length)));
 }
 
+namespace {
+
+// camchrome (1024): new Blob(..., {endings: "native"}) writes the claimed OS's line ending,
+// CRLF for a Windows persona and LF for the others, as Chrome on that OS does.
+void CamchromeNormalizeLineEndingsToNative(const std::string& from,
+                                           Vector<uint8_t>& result) {
+  if (!ungoogled::PersonaActive()) {
+    NormalizeLineEndingsToNative(from, result);
+    return;
+  }
+  if (ungoogled::GetPersonaPlatform() != ungoogled::PersonaPlatform::kWindows) {
+    NormalizeLineEndingsToLf(from, result);
+    return;
+  }
+  // CR, LF and CRLF each become CRLF (line_ending.cc's NormalizeToCrLf).
+  result.reserve(result.size() + from.size());
+  for (size_t i = 0; i < from.size(); ++i) {
+    const char c = from[i];
+    if (c == '\r') {
+      if (i + 1 < from.size() && from[i + 1] == '\n')
+        ++i;
+      result.push_back('\r');
+      result.push_back('\n');
+    } else if (c == '\n') {
+      result.push_back('\r');
+      result.push_back('\n');
+    } else {
+      result.push_back(static_cast<uint8_t>(c));
+    }
+  }
+}
+
+}  // namespace
+
 void BlobData::AppendText(const String& text,
                           bool do_normalize_line_endings_to_native) {
   DCHECK_EQ(file_composition_, FileCompositionStatus::kNoUnknownSizeFiles)
