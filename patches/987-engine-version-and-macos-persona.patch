+const char* EngineVersionNumber() {
+  // Process-lifetime: the build's own version, never a seed table entry. Claiming
+  // a Chrome major the engine is not is the single cheapest contradiction to
+  // detect (the engine's feature set and the wire's Accept header both leak it).
+  static const std::string kVersion(version_info::GetVersionNumber());
+  return kVersion.c_str();
+}
