+void WebGLRenderingContextBase::ApplyPersonaReadPixelsNoise(
+    void* data,
+    GLsizei width,
+    GLsizei height,
+    GLenum format,
+    GLenum type,
+    GLint x,
+    GLint y) {
+  if (isContextLost() || !GetDrawingBuffer() || !data)
+    return;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kFingerprint) ||
+      !ungoogled::FingerprintNoiseEnabled() ||
+      ungoogled::CurrentPersona().webgl_real) {
+    return;
   }
+  SkColorType color_type;
+  if (format == GL_RGBA && type == GL_UNSIGNED_BYTE) {
+    color_type = kRGBA_8888_SkColorType;
+  } else if (format == GL_RGB && type == GL_UNSIGNED_BYTE) {
+    color_type = kRGB_888x_SkColorType;
+  } else {
+    // Only byte layouts the perturb routine understands; anything else is left
+    // untouched rather than misread as RGBA.
+    return;
+  }
+
+  // readPixels leaves destination bytes outside the framebuffer untouched. The
+  // perturb pass must clip to the intersection, or it rewrites sentinels the
+  // browser never wrote (a spec violation any page can detect).
+  const int fb_w = GetDrawingBuffer()->Size().width();
+  const int fb_h = GetDrawingBuffer()->Size().height();
+  const int clip_x = std::max(0, -static_cast<int>(x));
+  const int clip_y = std::max(0, static_cast<int>(y) + height - fb_h);
+  const int clip_w = std::min(static_cast<int>(width), fb_w - x) - clip_x;
+  const int clip_h = std::min(static_cast<int>(height), y + height) - clip_y;
+  if (clip_w <= 0 || clip_h <= 0)
+    return;
+
+  const SecurityOrigin* origin =
+      GetExecutionContext() ? GetExecutionContext()->GetSecurityOrigin()
+                            : nullptr;
+  const uint64_t seed = ungoogled::GetFarbleSeed64(
+      origin ? origin->RegistrableDomain().Utf8() : std::string());
+  SkImageInfo image_info = SkImageInfo::Make(width, height, color_type,
+                                             kUnpremul_SkAlphaType,
+                                             /*color_space=*/nullptr);
+  StaticBitmapImage::ShuffleSubchannelColorData(
+      data, image_info, x, y, seed, /*bottom_up=*/true, clip_x, clip_y, clip_w,
+      clip_h);
 }
 
