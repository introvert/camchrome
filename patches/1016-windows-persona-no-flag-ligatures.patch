 inline bool ShapeRange(hb_buffer_t* buffer,
                        const FontFeatureRanges& font_features,
                        const SimpleFontData* current_font,
@@ -1058,6 +1068,24 @@
           font_features);
     }
 
+    // camchrome (1016): Windows' Segoe UI Emoji has no flag glyphs, so a regional-indicator
+    // pair is two letters on Windows; Noto Color Emoji joins it into a flag through 'ccmp'
+    // (Clearcote audit: "emoji come from the claimed OS's emoji font"). Under a Windows persona
+    // 'ccmp' is off at regional-indicator positions only, so ZWJ and skin-tone sequences, which
+    // Segoe UI Emoji does form, still shape. The saver above restores the list per segment.
+    if (PersonaShapesLikeWindows() && !text_.Is8Bit()) {
+      const base::span<const UChar> chars = text_.Span16();
+      for (unsigned i = shape_start; i < shape_end;) {
+        const unsigned at = i;
+        UChar32 c;
+        U16_NEXT(chars.data(), i, shape_end, c);
+        if (c >= 0x1F1E6 && c <= 0x1F1FF) {
+          font_features.push_back(FontFeatureRange{
+              {FontFeatureTag('c', 'c', 'm', 'p'), 0}, at, i});
+        }
+      }
+    }
