+// camchrome (1016): text shaped as on Windows (see the regional-indicator note in Shape()).
+bool PersonaShapesLikeWindows() {
+  static const bool kWindows =
+      ungoogled::PersonaActive() &&
+      ungoogled::GetPersonaPlatform() == ungoogled::PersonaPlatform::kWindows;
+  return kWindows;
+}
