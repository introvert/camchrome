+// camchrome (1028)
+TNode<Float64T> CodeStubAssembler::CcArmNaNFloat64(TNode<Float64T> value) {
+  TVARIABLE(Float64T, var_result, value);
+  Label done(this);
+  GotoIf(Word32Equal(Load<Uint8T>(ExternalConstant(
+                         ExternalReference::cc_arm_nan_flag())),
+                     Int32Constant(0)),
+         &done);
+  GotoIf(Float64Equal(value, value), &done);
+  var_result = Float64Abs(value);
+  Goto(&done);
+  BIND(&done);
+  return var_result.value();
+}
